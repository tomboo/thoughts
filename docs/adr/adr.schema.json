{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/thoughts/adr.schema.json",
  "title": "Thoughts ADR Frontmatter",
  "type": "object",
  "additionalProperties": true,
  "required": ["adr_id", "title", "status", "date", "deciders", "tags"],
  "properties": {
    "adr_id": {
      "type": "string",
      "pattern": "^[0-9]{4}$",
      "description": "Zero-padded ADR number matching the filename prefix."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "accepted", "superseded", "deprecated", "rejected"]
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "deciders": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{4}$"
      },
      "default": []
    },
    "superseded_by": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}$"
    },
    "tags": {
      "type": "array",
      "contains": {
        "const": "adr"
      },
      "items": {
        "type": "string"
      }
    }
  }
}
